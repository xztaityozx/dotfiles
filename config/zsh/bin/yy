#!/usr/bin/env zsh

CMD=""
type clip.exe &> /dev/null && CMD=clip.exe
type pbcopy &> /dev/null && CMD=pbcopy

if [[ "$CMD" == "clip.exe" ]]; then
  iconv -f UTF-8 -t UTF-16LE | "$CMD"
elif [[ -n "$CMD" ]]; then
  "$CMD"
elif [[ -n "$TMUX" ]]; then
  # popupでは、開いた側のクライアントにOSC 52を送る
  local client_tty="$(tmux show-options -qv @yy-client-tty)"
  if [[ -n "$client_tty" ]]; then
    tmux load-buffer -w -t "$client_tty" -
  else
    tmux load-buffer -w -
  fi
else
  # tmux外でのOSC 52フォールバック
  local data
  data="$(cat | base64)"
  printf "\e]52;c;%s\a" "$data"
fi
